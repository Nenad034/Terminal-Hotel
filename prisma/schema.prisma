  correctiveActionId       String?   @map("corrective_action_id") @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz

  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  involvedGuest    GuestProfile?     @relation(fields: [involvedGuestId], references: [id])
  involvedEmployee Employee?         @relation("InvolvedEmployee", fields: [involvedEmployeeId], references: [id])
  reportedBy       Employee?         @relation("ReportedBy", fields: [reportedByEmployeeId], references: [id])
  correctiveAction CorrectiveAction? @relation(fields: [correctiveActionId], references: [id])

  @@index([propertyId, occurredAt], name: "idx_incident_property_time")
  @@map("incident_report")
}


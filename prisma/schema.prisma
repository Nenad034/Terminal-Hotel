}

model IncidentReport {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId               String    @map("property_id") @db.Uuid
  incidentType             String    @map("incident_type")
  occurredAt               DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  location                 String?
  involvedGuestId          String?   @map("involved_guest_id") @db.Uuid
  involvedEmployeeId       String?   @map("involved_employee_id") @db.Uuid

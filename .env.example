# Terminal Hotel — Backend Environment
# Kopirajte u .env i prilagodite lokalno

# Database
DATABASE_URL="postgresql://terminalhotel:th_secret@localhost:5436/terminalhotel?schema=public"
POSTGRES_USER=terminalhotel
POSTGRES_PASSWORD=th_secret
POSTGRES_DB=terminalhotel

# Redis
REDIS_URL="redis://localhost:6381"

# App
PORT=3010
NODE_ENV=development

# JWT (prilagodite za produkciju — min 32 karaktera)
JWT_SECRET=terminal_hotel_jwt_secret_change_in_production
JWT_EXPIRES_IN=8h

# Night Audit — vreme pokretanja (HH:MM, lokalno vreme servera)
NIGHT_AUDIT_TIME=03:00

# TTL Sweep interval (sekunde)
TTL_SWEEP_INTERVAL_SECONDS=60
